rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserData() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return (
        (isSignedIn() && (
          request.auth.token.email == 'citrinemobilite@gmail.com' ||
          request.auth.token.email == 'landrymouns@gmail.com' ||
          request.auth.token.email == 'admin@vtc-pricing.internal' ||
          (hasUserData() && getUserData().role == 'admin')
        ))
      );
    }

    function isResponsable() {
      return isSignedIn() && (
        isAdmin() ||
        (hasUserData() && getUserData().role == 'responsable')
      );
    }

    function isStaff() {
      return isSignedIn() && (
        isAdmin() ||
        isResponsable() ||
        (hasUserData() && getUserData().role == 'employe')
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    // USERS COLLECTION:
    // Staff and public profile lookup, creation of users with valid ID
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId);
      allow delete: if isAdmin() && isValidId(userId);
    }

    // CITIES COLLECTION:
    // Catalog of operating cities and regions
    match /cities/{cityId} {
      allow read: if true;
      allow create, update: if isValidId(cityId);
      allow delete: if isAdmin() && isValidId(cityId);

      // NEIGHBORHOODS SUB-COLLECTION:
      match /neighborhoods/{neighborhoodId} {
        allow read: if true;
        allow create, update: if isValidId(neighborhoodId);
        allow delete: if (isAdmin() || isResponsable()) && isValidId(neighborhoodId);
      }
    }

    // NEIGHBORHOODS TOP-LEVEL COLLECTION:
    match /neighborhoods/{neighborhoodId} {
      allow read: if true;
      allow create, update: if isValidId(neighborhoodId);
      allow delete: if (isAdmin() || isResponsable()) && isValidId(neighborhoodId);
    }

    // PRICING CAMPAIGNS:
    match /campaigns/{campaignId} {
      allow read: if true;
      allow create, update: if isValidId(campaignId);
      allow delete: if isValidId(campaignId);

      // TRIP RESULTS SUB-COLLECTION:
      match /trip_results/{resultId} {
        allow read: if true;
        allow create, update: if isValidId(resultId);
        allow delete: if isValidId(resultId);
      }
    }
  }
}
