rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        getUserData().role == 'admin' ||
        request.auth.token.email == 'citrinemobilite@gmail.com' ||
        request.auth.token.email == 'landrymouns@gmail.com' ||
        request.auth.token.email == 'admin@vtc-pricing.internal'
      );
    }

    function isResponsable() {
      return isSignedIn() && (
        isAdmin() ||
        getUserData().role == 'responsable'
      );
    }

    function isStaff() {
      return isSignedIn() && (
        isAdmin() ||
        isResponsable() ||
        getUserData().role == 'employe'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // USERS COLLECTION:
    // Read: authenticated staff can read users; users can read their own profile
    // Write: only admin can create, update, or deactivate users
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isResponsable());
      allow create, update, delete: if isAdmin() && isValidId(userId);
    }

    // CITIES COLLECTION:
    // Read: all staff can view cities
    // Write: admin and responsable can create and update cities
    match /cities/{cityId} {
      allow read: if isStaff() && isValidId(cityId);
      allow create, update: if isResponsable() && isValidId(cityId);
      allow delete: if isAdmin() && isValidId(cityId);

      // NEIGHBORHOODS SUB-COLLECTION:
      match /neighborhoods/{neighborhoodId} {
        allow read: if isStaff() && isValidId(neighborhoodId);
        allow create, update: if isResponsable() && isValidId(neighborhoodId);
        allow delete: if isResponsable() && isValidId(neighborhoodId);
      }
    }

    // PRICING CAMPAIGNS:
    // Read: all staff
    // Create: all staff (including employees running a pricing)
    // Update: backend/cloud function or staff running the campaign
    match /campaigns/{campaignId} {
      allow read: if isStaff() && isValidId(campaignId);
      allow create: if isStaff() && isValidId(campaignId);
      allow update: if isStaff() && isValidId(campaignId);
      allow delete: if isAdmin() && isValidId(campaignId);

      // TRIP RESULTS SUB-COLLECTION:
      match /trip_results/{resultId} {
        allow read: if isStaff() && isValidId(resultId);
        allow create, update: if isStaff() && isValidId(resultId);
        allow delete: if isAdmin() && isValidId(resultId);
      }
    }
  }
}
